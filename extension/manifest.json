{
  "manifest_version": 3,
  "name": "Nox-Safe — Shield Your Safe Transactions",
  "short_name": "Nox-Safe",
  "version": "0.1.0",
  "description": "Confidential transaction guard for Safe multisig. Encrypt intents with iExec Nox TEE.",
  "homepage_url": "https://noxsafe.vercel.app",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://app.safe.global/*",
    "https://gateway-testnets.noxprotocol.dev/*",
    "https://sepolia.drpc.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://app.safe.global/*"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
